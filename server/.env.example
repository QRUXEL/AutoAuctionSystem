# --- access ---
REVIEW_PASSWORD=choose-a-password        # for the review page (any user name)
STATION_KEY=choose-a-long-random-string  # same value goes in station/config.toml

# --- camera upload (FTP) ---
FTP_USER=camera
FTP_PASSWORD=choose-a-password
FTP_PORT=2121
FTP_PASSIVE_PORTS=30000-30009
FTP_PUBLIC_HOST=10.8.0.247               # LAN IP of the Coolify host, as the camera reaches it

# --- capture ---
EXPECTED_PHOTOS=4
EXPECTED_VIDEOS=1
GRACE_SECONDS=120

# --- AI description ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
LISTING_LANGUAGE=Swedish
AI_EXTRA_INSTRUCTIONS=

# --- Tradera (REST API v4) ---
TRADERA_APP_ID=
TRADERA_APP_KEY=
TRADERA_USER_ID=
TRADERA_USER_TOKEN=
TRADERA_DRY_RUN=1                        # set to 0 only when you want Publish to go live
